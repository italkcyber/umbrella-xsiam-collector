//     xdm.network.rule = rule_id,
//     xdm.event.outcome = if(action = "blocked", XDM_CONST.OUTCOME_FAILED, XDM_CONST.OUTCOME_SUCCESS);


// ===========================================================================
//  ADMIN AUDIT logs - every licence.  Folder: auditlogs/
//  NOTE: written only when an administrator changes something. On a quiet org
//  no audit event exists yet, and the validator will reject these fields as
//  unknown. Make a policy change in Umbrella, wait one fetch, then enable.
// ===========================================================================
// filter source_log_type = "auditlogs"
// | alter
//     xdm.observer.vendor = "Cisco",
//     xdm.observer.product = "Umbrella",
//     xdm.event.type = "administrative-action",
//     xdm.event.operation = action,
//     xdm.event.id = to_string(id),
//     xdm.source.user.username = coalesce(user, email),
//     xdm.source.ipv4 = ip,
//     xdm.event.description = concat(action, " on ", type);
//
// EXTRAS for auditlogs:
//     xdm.source.user.upn = email,
//     xdm.target.resource.type = type,
