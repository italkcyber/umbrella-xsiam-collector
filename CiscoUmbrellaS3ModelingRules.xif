// filter source_log_type = "intrusionlogs"
// | alter
//     xdm.observer.vendor = "Cisco",
//     xdm.observer.product = "Umbrella",
//     xdm.event.type = "intrusion-detection",
//     xdm.alert.name = message,
//     xdm.alert.severity = severity,
